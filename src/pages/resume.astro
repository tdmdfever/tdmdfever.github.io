---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../utils/url';

const resumePdfHref = withBase('/resume.pdf');
const resumeImageHref = withBase('/resume-preview.png');
---

<Layout title="Resume" description="Resume.">
  <section class="resume-header">
    <h1>Resume</h1>
    <a class="button" href={resumePdfHref} download="Terry_Deng_Resume.pdf">Download PDF</a>
  </section>

  <section class="resume-preview-wrap">
    <div class="resume-sheet">
      <img class="resume-preview" src={resumeImageHref} alt="Resume preview" />
    </div>
  </section>
</Layout>

<style>
  .resume-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .resume-header h1 {
    margin-bottom: 0;
  }

  .resume-preview-wrap {
    display: flex;
    justify-content: center;
  }

  /* The preview is a black-on-white PDF page, which is a flashbang on a dark site.
     The image is multiplied onto a cream sheet: the page's white becomes the cream
     while black text stays black, so it reads as paper lying on the dark page.
     Only this preview changes; the downloadable PDF is untouched. `isolation`
     keeps the blend inside the sheet. */
  .resume-sheet {
    width: 100%;
    max-width: 48rem;
    isolation: isolate;
    background: var(--color-paper);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.5);
  }

  .resume-preview {
    display: block;
    width: 100%;
    mix-blend-mode: multiply;
  }
</style>
