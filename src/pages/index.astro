---
import Layout from '../layouts/Layout.astro';
import ContactLinks from '../components/ContactLinks.astro';
import FeaturedProjectTile from '../components/FeaturedProjectTile.astro';
import { site } from '../data/site';
import { withBase } from '../utils/url';
import { getFeaturedProjects, getEmbed } from '../utils/projects';

const { featured: featuredProjects } = await getFeaturedProjects();
---

<Layout title="Home">
  <section class="hero">
    <h1>{site.name}</h1>
    <p class="prose muted">{site.tagline}</p>
    <ContactLinks />
    <div class="hero__actions">
      <a class="button" href={withBase('/resume')}>Resume</a>
      <a class="button button--secondary" href="#projects">See projects</a>
    </div>
  </section>

  <section id="projects">
    <h2>Featured projects</h2>
    {featuredProjects.length > 0 ? (
      <div class="card-grid">
        {featuredProjects.map((project) => {
          const Embed = getEmbed(project);
          return Embed ? (
            <FeaturedProjectTile project={project} Embed={Embed} />
          ) : (
            <a class="card" id={`project-${project.id}`} href={withBase(`/projects/${project.id}`)}>
              <h3>{project.data.title}</h3>
              <p class="muted">{project.data.description}</p>
              {project.data.tags.length > 0 && (
                <ul class="tag-list">
                  {project.data.tags.map((tag) => <li class="tag">{tag}</li>)}
                </ul>
              )}
            </a>
          );
        })}
      </div>
    ) : (
      <p class="muted">No projects yet — check back soon.</p>
    )}
    <p class="projects__all"><a href={withBase('/projects')}>View all projects &rarr;</a></p>
  </section>
</Layout>

<style>
  .hero {
    padding-bottom: var(--space-2);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  /* Breathing room between the last project tile and this link */
  .projects__all {
    margin-top: var(--space-3);
  }

  /* Keep the anchored tile from hiding under the top of the viewport */
  :global([id^='project-']) {
    scroll-margin-top: var(--space-3);
  }
</style>
