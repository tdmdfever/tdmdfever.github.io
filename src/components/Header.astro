---
import { site } from '../data/site';
import { withBase } from '../utils/url';

const navItems = [
  { href: withBase('/'), label: 'Home' },
  { href: withBase('/resume'), label: 'Resume' },
  { href: withBase('/projects'), label: 'Projects' },
  { href: withBase('/updates'), label: 'Updates' },
];

const normalize = (path: string) => path.replace(/\/+$/, '') || '/';
const current = normalize(Astro.url.pathname);
const home = normalize(withBase('/'));
const isActive = (href: string) => {
  const target = normalize(href);
  return target === home ? current === target : current === target || current.startsWith(`${target}/`);
};
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__name" href={withBase('/')}>{site.name}</a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle-input" />
    <label for="nav-toggle" class="nav-toggle-label" aria-label="Toggle menu">
      <span></span>
      <span></span>
      <span></span>
    </label>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {navItems.map((item) => (
          <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
    position: relative;
  }

  .site-header__name {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1;
    color: var(--color-text);
  }

  .site-header__name:hover {
    text-decoration: none;
    color: var(--color-accent);
  }

  .nav-toggle-input {
    display: none;
  }

  .nav-toggle-label {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 28px;
    height: 22px;
    cursor: pointer;
  }

  .nav-toggle-label span {
    display: block;
    height: 1px;
    background: var(--color-text);
  }

  .site-nav {
    display: none;
    width: 100%;
    order: 3;
  }

  .site-nav ul {
    list-style: none;
    margin: var(--space-2) 0 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .site-nav a {
    color: var(--color-text-muted);
    font-size: 0.88rem;
    font-weight: 500;
    padding-bottom: 0.2rem;
    border-bottom: 1px solid transparent;
  }

  .site-nav a:hover {
    color: var(--color-text);
    text-decoration: none;
  }

  .site-nav a[aria-current='page'] {
    color: var(--color-text);
    border-bottom-color: var(--color-accent);
  }

  .nav-toggle-input:checked ~ .site-nav {
    display: block;
  }

  @media (min-width: 640px) {
    .nav-toggle-label {
      display: none;
    }

    .site-nav {
      display: block;
      width: auto;
      order: initial;
    }

    .site-nav ul {
      flex-direction: row;
      gap: var(--space-3);
      margin: 0;
    }
  }
</style>
