---
import Inline from './Inline.astro';
import { resumeSections } from '../data/resume';

interface ProjectRef {
  href: string;
  links: { label: string; url: string }[];
}

interface Props {
  // Keyed by project slug; lets a resume entry link to its project's tile
  // and borrow that project's link buttons (Live Site, Repo, ...).
  projects?: Record<string, ProjectRef>;
}

const { projects = {} } = Astro.props;
---

<section class="resume" id="resume" aria-labelledby="resume-heading">
  <h2 id="resume-heading">Resume</h2>

  {resumeSections.map((section) => (
    <div class="resume__section">
      <h3 class="resume__section-title">
        <span>{section.title}</span>
        {section.titleRight && <span class="resume__section-note">{section.titleRight}</span>}
      </h3>

      {section.entries?.map((entry) => {
        const ref = entry.project ? projects[entry.project] : undefined;
        return (
          <div class="entry">
            <div class="entry__row entry__row--title">
              <h4 class="entry__title">
                {ref ? <a href={ref.href}>{entry.title}</a> : entry.title}
                {ref?.links.map((link) => (
                  <>
                    <span class="entry__sep" aria-hidden="true">|</span>
                    <a class="entry__link" href={link.url} target="_blank" rel="noreferrer noopener">{link.label}</a>
                  </>
                ))}
              </h4>
              {entry.titleRight && <span class="entry__right entry__right--bold">{entry.titleRight}</span>}
            </div>
            {(entry.subtitle || entry.subtitleRight) && (
              <div class="entry__row entry__row--subtitle">
                <span>{entry.subtitle}</span>
                {entry.subtitleRight && <span class="entry__right">{entry.subtitleRight}</span>}
              </div>
            )}
            <ul class="entry__bullets">
              {entry.bullets.map((bullet) => <li><Inline text={bullet} /></li>)}
            </ul>
          </div>
        );
      })}

      {section.rows && (
        <dl class="resume__rows">
          {section.rows.map((row) => (
            <div class="resume__row">
              <dt>{row.label}</dt>
              <dd><Inline text={row.text} /></dd>
            </div>
          ))}
        </dl>
      )}
    </div>
  ))}
</section>

<style>
  .resume {
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .resume h2 {
    margin-bottom: var(--space-3);
  }

  .resume__section + .resume__section {
    margin-top: var(--space-4);
  }

  .resume__section-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0 var(--space-2);
    margin: 0 0 0.9rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* Right-hand label on a section header, e.g. "100+ Community Service Hours" */
  .resume__section-note {
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--color-text-muted);
  }

  .entry + .entry {
    margin-top: 1.1rem;
  }

  .entry__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0 var(--space-2);
  }

  .entry__title {
    font-size: 0.95rem;
    margin: 0;
  }

  .entry__sep {
    margin: 0 0.5em;
    font-weight: 400;
    color: var(--color-border-strong);
  }

  .entry__link {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 400;
  }

  .entry__right {
    margin-left: auto;
    text-align: right;
    font-style: italic;
    color: var(--color-text-muted);
  }

  /* Dates and other bold right-hand data: mono, tabular */
  .entry__right--bold {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-style: normal;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
  }

  .entry__row--subtitle {
    font-style: italic;
    color: var(--color-text-muted);
  }

  /* Dot bullets, drawn rather than typed, so they never depend on a font */
  .entry__bullets {
    margin: 0.35rem 0 0;
    padding-left: 1.1rem;
    list-style: none;
  }

  .entry__bullets li {
    position: relative;
  }

  .entry__bullets li::before {
    content: '';
    position: absolute;
    left: -1.1rem;
    top: 0.62em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-border-strong);
  }

  .entry__bullets li + li {
    margin-top: 0.2rem;
  }

  .resume__rows {
    margin: 0;
  }

  .resume__row {
    display: flex;
    gap: var(--space-2);
  }

  .resume__row + .resume__row {
    margin-top: 0.3rem;
  }

  .resume__row dt {
    flex: none;
    width: 7.4rem;
    padding-top: 0.15em;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .resume__row dd {
    margin: 0;
  }
</style>
