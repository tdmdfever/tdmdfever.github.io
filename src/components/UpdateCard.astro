---
import { withBase } from '../utils/url';

interface Props {
  update: {
    id: string;
    data: { title: string; description: string; date: Date };
  };
}

const { update } = Astro.props;
const dateLabel = update.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<a class="update-card" href={withBase(`/updates/${update.id}`)}>
  <div class="update-card__head">
    <span class="update-card__title">{update.data.title}</span>
    <span class="muted update-card__date">{dateLabel}</span>
  </div>
  <p class="muted update-card__description">{update.data.description}</p>
</a>

<style>
  .update-card {
    display: block;
    padding: var(--space-2) 0;
    color: var(--color-text);
  }

  .update-card:hover {
    text-decoration: none;
  }

  .update-card:hover .update-card__title {
    text-decoration: underline;
  }

  .update-card__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .update-card__title {
    font-weight: 600;
  }

  .update-card__date {
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .update-card__description {
    margin: 0.3rem 0 0 0;
  }
</style>
